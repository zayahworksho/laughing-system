  <div class="services">
    
    <div class="card">
      <h3>Video Editing</h3>
      <p>Content editing, cinematic videos, transitions, and effects.</p>
    </div>

    <div class="card">
      <h3>Graphic Design</h3>
      <p>Logos, social media posts, banners, and branding.</p>
    </div>

    <div class="card">
      <h3>Photo Editing</h3>
      <p>Retouching, background editing, and ID pictures.</p>
    </div>

    <div class="card">
      <h3>Phone Repair</h3>
      <p>Screen replacement and basic troubleshooting.</p>
    </div>

    <div class="card">
      <h3>Subscriptions</h3>
      <p>Netflix, Disney+, CapCut Pro, Canva Pro, ChatGPT Plus.</p>
    </div>

  </div>
</section>

